{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:org.spicetrellis:simulation-result:1",
  "title": "SpiceTrellis Simulation Result version 1",
  "description": "Structural interchange contract. The reader additionally enforces finite binary64 samples, normalized safe names, case-insensitive uniqueness, rectangular shape, dimension products and complete-artifact resource limits. The input digest is not proof of simulator convergence or trusted provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "format", "source_sha256", "plots"],
  "properties": {
    "schema": {"const": "org.spicetrellis.simulation-result"},
    "schema_version": {"type": "integer", "const": 1},
    "format": {"$ref": "#/$defs/token"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "maxLength": 64},
    "plots": {
      "type": "array", "minItems": 1, "maxItems": 4096,
      "items": {"$ref": "#/$defs/plot"}
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 16384},
    "token": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^\\S+$"},
    "number": {"type": "number", "minimum": -1.7976931348623157e308, "maximum": 1.7976931348623157e308},
    "complex": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {"$ref": "#/$defs/number"}
    },
    "variable": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "quantity", "display_grid"],
      "properties": {
        "name": {"$ref": "#/$defs/token"},
        "quantity": {"$ref": "#/$defs/token"},
        "display_grid": {"type": ["integer", "null"], "minimum": 0, "maximum": 255}
      }
    },
    "plot": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "analysis", "encoding", "variables", "columns", "dimensions", "metadata"],
      "properties": {
        "title": {"$ref": "#/$defs/text"},
        "analysis": {"$ref": "#/$defs/text"},
        "encoding": {"enum": ["real", "complex"]},
        "variables": {
          "type": "array", "minItems": 1, "maxItems": 16384,
          "items": {"$ref": "#/$defs/variable"}
        },
        "columns": {
          "type": "array", "minItems": 1, "maxItems": 16384,
          "items": {"type": "array", "minItems": 1, "maxItems": 8000000}
        },
        "dimensions": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "items": {"type": "integer", "minimum": 1, "maximum": 8000000}
        },
        "metadata": {
          "type": "array", "maxItems": 128,
          "items": {
            "type": "array", "minItems": 2, "maxItems": 2,
            "prefixItems": [
              {"type": "string", "minLength": 1, "maxLength": 128},
              {"$ref": "#/$defs/text"}
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"encoding": {"const": "real"}}},
          "then": {"properties": {"columns": {"items": {"items": {"$ref": "#/$defs/number"}}}}},
          "else": {"properties": {"columns": {"items": {"items": {"$ref": "#/$defs/complex"}}}}}
        }
      ]
    }
  }
}
