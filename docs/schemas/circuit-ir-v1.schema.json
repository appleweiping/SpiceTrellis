{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:org.spicetrellis:circuit-ir:1",
  "title": "SpiceTrellis Circuit IR version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "entry",
    "modules",
    "models",
    "global_nodes",
    "dependencies",
    "losses"
  ],
  "properties": {
    "schema": {"const": "org.spicetrellis.circuit-ir"},
    "schema_version": {"const": 1},
    "entry": {"$ref": "#/$defs/path"},
    "modules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/module"}
    },
    "models": {
      "type": "array",
      "maxItems": 100000,
      "items": {"$ref": "#/$defs/model"}
    },
    "global_nodes": {"$ref": "#/$defs/tokens"},
    "dependencies": {
      "type": "array",
      "maxItems": 100000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/path"}
    },
    "losses": {
      "type": "array",
      "maxItems": 100000,
      "items": {"$ref": "#/$defs/loss"}
    }
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1, "maxLength": 1000000},
    "string": {"type": "string", "maxLength": 1000000},
    "path": {
      "type": "string",
      "pattern": "^[\\u0021-\\u007e]+$",
      "minLength": 1,
      "maxLength": 1000000
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.$:-]*$",
      "maxLength": 1000000
    },
    "moduleName": {
      "anyOf": [
        {"const": "$top"},
        {"$ref": "#/$defs/identifier"}
      ]
    },
    "token": {
      "type": "string",
      "pattern": "^[\\u0021-\\u007e]+$",
      "maxLength": 1000000
    },
    "strings": {
      "type": "array",
      "maxItems": 100000,
      "items": {"$ref": "#/$defs/nonempty"}
    },
    "tokens": {
      "type": "array",
      "maxItems": 100000,
      "items": {"$ref": "#/$defs/token"}
    },
    "position": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 1, "maximum": 2147483647},
        {"type": "integer", "minimum": 1, "maximum": 2147483647}
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "source": {
      "type": "object",
      "description": "A one-based half-open source range: start is inclusive, end is exclusive, and columns count Unicode scalar values.",
      "additionalProperties": false,
      "required": ["file", "start", "end"],
      "properties": {
        "file": {"$ref": "#/$defs/path"},
        "start": {
          "description": "Inclusive one-based [line, column] position.",
          "$ref": "#/$defs/position"
        },
        "end": {
          "description": "Exclusive one-based [line, column] position.",
          "$ref": "#/$defs/position"
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "expression", "source"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "expression": {"$ref": "#/$defs/nonempty"},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "family",
        "connections",
        "model",
        "value",
        "source_form",
        "parameters",
        "source"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/nonempty"},
        "name": {"$ref": "#/$defs/identifier"},
        "family": {"enum": ["R", "C", "L", "V", "I", "M", "X"]},
        "connections": {
          "type": "array",
          "maxItems": 4096,
          "items": {"$ref": "#/$defs/token"}
        },
        "model": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/identifier"}
          ]
        },
        "value": {"type": ["string", "null"], "maxLength": 1000000},
        "source_form": {"type": ["string", "null"], "maxLength": 1000000},
        "parameters": {
          "type": "array",
          "maxItems": 4096,
          "items": {"$ref": "#/$defs/parameter"}
        },
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "ports", "parameters", "instances", "source"],
      "properties": {
        "name": {"$ref": "#/$defs/moduleName"},
        "ports": {
          "type": "array",
          "maxItems": 4096,
          "items": {"$ref": "#/$defs/token"}
        },
        "parameters": {
          "type": "array",
          "maxItems": 4096,
          "items": {"$ref": "#/$defs/parameter"}
        },
        "instances": {
          "type": "array",
          "maxItems": 1000000,
          "items": {"$ref": "#/$defs/instance"}
        },
        "source": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/source"}
          ]
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "module", "name", "kind", "source_form", "source"],
      "properties": {
        "id": {"$ref": "#/$defs/nonempty"},
        "module": {"$ref": "#/$defs/moduleName"},
        "name": {"$ref": "#/$defs/identifier"},
        "kind": {"$ref": "#/$defs/identifier"},
        "source_form": {"$ref": "#/$defs/string"},
        "source": {"$ref": "#/$defs/source"}
      }
    },
    "loss": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "reason", "card", "source"],
      "properties": {
        "module": {"$ref": "#/$defs/moduleName"},
        "reason": {"$ref": "#/$defs/nonempty"},
        "card": {"$ref": "#/$defs/string"},
        "source": {"$ref": "#/$defs/source"}
      }
    }
  }
}
